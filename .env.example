# Public HTTPS URL of this server. The OAuth discovery documents and the
# connector URL shown on the account page are built from it, so it must match
# what people paste into claude.ai - including the scheme.
PUBLIC_URL=https://mcp.garmin.example.com

# Encrypts the stored Garmin tokens and must stay stable: change it and every
# account has to reconnect Garmin. The server refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=
