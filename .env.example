# Public HTTPS URL of this server. The OAuth discovery documents are built from
# it, so it must match what the connector was given - including the scheme.
PUBLIC_URL=https://mcp-garmin.example.com

# Passphrase for the consent screen. Anyone who knows it can connect a client
# to YOUR Garmin data, so treat it like a password. Without it the server
# refuses to authorize connectors at all.
MCP_PASSPHRASE=

# Optional: static bearer token for clients that can send headers (Claude Code,
# Claude Desktop). claude.ai and ChatGPT cannot - those use OAuth above.
MCP_TOKEN=

# Optional: the Garmin tokens as a base64 blob, from `garmin-mcp export`.
# Use this on hosts without a persistent disk; otherwise mount /data and put
# the file there instead.
GARMIN_TOKENS=
